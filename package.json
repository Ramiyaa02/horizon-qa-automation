{
  "name": "qa-horizon-assignment",
  "version": "0.1.0",
  "private": true,
  "description": "QA automation assignment: Lighthouse web performance monitoring tool + Playwright login automation",
  "scripts": {
    "lh": "ts-node lighthouse-tool/bin/lh-audit.ts",
    "ui:test": "playwright test --config=ui-tests/playwright.config.ts",
    "ui:test:headed": "playwright test --config=ui-tests/playwright.config.ts --headed",
    "ui:report": "playwright show-report --config=ui-tests/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "chrome-launcher": "^1.2.1",
    "dotenv": "^17.4.2",
    "lighthouse": "^13.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
